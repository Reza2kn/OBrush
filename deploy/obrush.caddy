# Managed by OBrush deployment. Existing sites remain in their own files.
obrush.app, www.obrush.app {
	root * /var/www/obrush/current
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@entry path / /index.html /build-info.json
	header @entry Cache-Control "no-cache"
	file_server
}
