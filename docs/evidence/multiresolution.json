  "semantics": {
    "geometry": "Add Loop(new parent)-Loop(old parent) to its existing finer mesh, retaining finer sculpt offsets as additive world-space detail; repeat upward. Fine edits do not reverse-project into coarse levels.",
    "attributes": "Analogous interpolated additive mask/RGB deltas are clamped to 0-1. Unchanged channels copy exactly. Fine attributes do not project down; finer masks do not automatically protect parent-level edits.",
    "history": "Selection does not consume an undo entry. Add/sculpt/topology and project replacements snapshot whole mesh/name/hierarchy state.",
    "topology": "Stored levels have fixed topology; the app disables adaptive brush splitting. Explicit replacement/refinement/remesh/accepted decimation clears the stack; Undo restores it. Zero-collapse decimation preserves hierarchy and redo.",
    "project": "Version2 has optional multiresolution scheme loop_world_offsets_v1, ordered level list and active index. Exactly the active slot is null and supplied by top-level mesh. Version1 flat files remain supported. Unknown/malformed fields, unsupported topology, collapsed hierarchy triangles and excess aggregate allocation reject atomically.",
    "transport_limit": "Saved world-space residuals do not rotate/scale with coarse frames. Large reshaping can distort detail or create intersections. No normal-frame transport, inverse projection or HD geometry."
  },
  "limits": {
    "maximum_levels": 8,
    "aggregate_unique_vertices": 1000000,
    "aggregate_unique_triangles": 2000000,
    "project_input_output_bytes": 134217728,
